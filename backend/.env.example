# Copie para .env (que está no .gitignore) e preencha. Nunca commite valores reais.

# Postgres do Supabase pelo pooler de transação (porta 6543).
# Para testar sem banco real, use: sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# Validação do login do produtor. Use um dos dois:
# - projetos com chaves de assinatura novas (assimétricas): SUPABASE_URL basta (o backend busca o JWKS)
# - projetos com segredo compartilhado (legado, HS256): SUPABASE_JWT_SECRET
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Origens permitidas (regex). O padrão já cobre localhost e domínios do Lovable.
# CORS_ORIGIN_REGEX=

# IA
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web Push (gere o par com: python -m app.notifications.generate_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
